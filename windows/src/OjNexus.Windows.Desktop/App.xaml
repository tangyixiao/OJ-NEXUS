<Application x:Class="OjNexus.Windows.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <SolidColorBrush x:Key="NexusBackgroundBrush" Color="#080C12" />
    <SolidColorBrush x:Key="NexusSurfaceBrush" Color="#0D141D" />
    <SolidColorBrush x:Key="NexusSurfaceRaisedBrush" Color="#111B27" />
    <SolidColorBrush x:Key="NexusBorderBrush" Color="#26364A" />
    <SolidColorBrush x:Key="NexusTextBrush" Color="#E7EDF5" />
    <SolidColorBrush x:Key="NexusMutedTextBrush" Color="#8190A5" />
    <SolidColorBrush x:Key="NexusAccentBrush" Color="#4DA3FF" />
    <SolidColorBrush x:Key="NexusPositiveBrush" Color="#69D39A" />
    <SolidColorBrush x:Key="NexusWarningBrush" Color="#E8B86A" />

    <Style TargetType="{x:Type Window}">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource NexusTextBrush}" />
      <Setter Property="Background" Value="{StaticResource NexusBackgroundBrush}" />
    </Style>

    <Style x:Key="NavButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource NexusMutedTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,3,0,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource NexusTextBrush}" />
          <Setter Property="Background" Value="{StaticResource NexusSurfaceRaisedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ActionButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource NexusBackgroundBrush}" />
      <Setter Property="Background" Value="{StaticResource NexusAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource NexusAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#73B8FF" />
          <Setter Property="BorderBrush" Value="#73B8FF" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.55" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{StaticResource NexusTextBrush}" />
      <Setter Property="Background" Value="{StaticResource NexusBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource NexusBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{StaticResource NexusTextBrush}" />
      <Setter Property="Background" Value="{StaticResource NexusBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource NexusBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Application.Resources>
</Application>
