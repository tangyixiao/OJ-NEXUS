<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- The portable contract is read-only; the golden corpus is consumed in
         place from contracts/ (never copied into the Windows tree). -->
    <Content Include="..\..\..\contracts\portable\v1\golden\**\*.json" Link="portable\golden\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
