<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-first, single-activity Compose app. The Compose layer owns all real theming;
         this theme only guarantees a dark chrome before the first frame. -->
    <style name="Theme.OJNexus" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
